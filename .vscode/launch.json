{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Isar Flow",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/extension"],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Isar Flow (fixture workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/packages/extension/test/fixtures/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
