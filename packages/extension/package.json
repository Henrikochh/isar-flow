{
  "name": "isar-flow",
  "displayName": "Isar Flow",
  "description": "Configure AI agents and build YAML workflows visually: agents, console commands, loops and conditions.",
  "version": "0.2.0",
  "publisher": "isarflow",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b2622",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "llm",
    "litellm",
    "copilot",
    "yaml",
    "automation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.workflow.yaml",
    "workspaceContains:.isarflow/**"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workflows and agents can be viewed, edited and simulated, but not run, in Restricted Mode.",
      "restrictedConfigurations": [
        "isarFlow.providers"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "isarFlow",
          "title": "Isar Flow",
          "icon": "media/isar-flow.svg"
        }
      ]
    },
    "views": {
      "isarFlow": [
        {
          "type": "webview",
          "id": "isarFlow.sidebar",
          "name": "Isar Flow"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "isarFlow.workflowEditor",
        "displayName": "Isar Flow canvas",
        "selector": [
          {
            "filenamePattern": "*.workflow.yaml"
          },
          {
            "filenamePattern": "*.workflow.yml"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "isarFlow.agentEditor",
        "displayName": "Isar Flow agent editor",
        "selector": [
          {
            "filenamePattern": "*.agent.yaml"
          },
          {
            "filenamePattern": "*.agent.yml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "isarFlow.newWorkflow",
        "title": "New workflow",
        "category": "Isar Flow",
        "icon": "$(add)"
      },
      {
        "command": "isarFlow.newAgent",
        "title": "New agent",
        "category": "Isar Flow",
        "icon": "$(person-add)"
      },
      {
        "command": "isarFlow.runWorkflow",
        "title": "Run workflow",
        "category": "Isar Flow",
        "icon": "$(play)"
      },
      {
        "command": "isarFlow.simulateWorkflow",
        "title": "Simulate workflow",
        "category": "Isar Flow",
        "icon": "$(beaker)"
      },
      {
        "command": "isarFlow.runFromHere",
        "title": "Run from here",
        "category": "Isar Flow",
        "icon": "$(debug-continue)"
      },
      {
        "command": "isarFlow.openSimulationFile",
        "title": "Open simulation file",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.cancelRun",
        "title": "Stop run",
        "category": "Isar Flow",
        "icon": "$(debug-stop)"
      },
      {
        "command": "isarFlow.openInCanvas",
        "title": "Open in Isar Flow editor",
        "category": "Isar Flow",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "isarFlow.openYaml",
        "title": "Open YAML",
        "category": "Isar Flow",
        "icon": "$(go-to-file)"
      },
      {
        "command": "isarFlow.addProvider",
        "title": "Add model endpoint",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.editProvider",
        "title": "Edit model endpoint",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.removeProvider",
        "title": "Remove model endpoint",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.setProviderKey",
        "title": "Set provider API key",
        "category": "Isar Flow",
        "icon": "$(key)"
      },
      {
        "command": "isarFlow.testProvider",
        "title": "Test model endpoint",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.refreshModels",
        "title": "Refresh models",
        "category": "Isar Flow",
        "icon": "$(refresh)"
      },
      {
        "command": "isarFlow.testModel",
        "title": "Test model",
        "category": "Isar Flow",
        "icon": "$(beaker)"
      },
      {
        "command": "isarFlow.checkSetup",
        "title": "Check setup",
        "category": "Isar Flow",
        "icon": "$(checklist)"
      },
      {
        "command": "isarFlow.setSecret",
        "title": "Set workflow secret",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.showLog",
        "title": "Show log",
        "category": "Isar Flow",
        "icon": "$(output)"
      },
      {
        "command": "isarFlow.runWorkflowOnSelection",
        "title": "Run workflow on selection",
        "category": "Isar Flow",
        "icon": "$(play)"
      },
      {
        "command": "isarFlow.exportRunReport",
        "title": "Export run report",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.copyRunForPr",
        "title": "Copy run for PR description",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.showTriggers",
        "title": "Show triggers",
        "category": "Isar Flow"
      },
      {
        "command": "isarFlow.openMemory",
        "title": "Open project memory",
        "category": "Isar Flow"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "isarFlow.runWorkflow",
          "alt": "isarFlow.simulateWorkflow",
          "when": "activeCustomEditorId == isarFlow.workflowEditor || resourceFilename =~ /\\.workflow\\.ya?ml$/",
          "group": "navigation@1"
        },
        {
          "command": "isarFlow.openYaml",
          "when": "activeCustomEditorId == isarFlow.workflowEditor || activeCustomEditorId == isarFlow.agentEditor",
          "group": "navigation@2"
        },
        {
          "command": "isarFlow.openInCanvas",
          "when": "!activeCustomEditorId && resourceFilename =~ /\\.(workflow|agent)\\.ya?ml$/",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "isarFlow.refreshModels",
          "when": "view == isarFlow.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "isarFlow.checkSetup",
          "when": "view == isarFlow.sidebar",
          "group": "overflow"
        },
        {
          "command": "isarFlow.showLog",
          "when": "view == isarFlow.sidebar",
          "group": "overflow"
        }
      ],
      "explorer/context": [
        {
          "command": "isarFlow.runWorkflow",
          "when": "resourceFilename =~ /\\.workflow\\.ya?ml$/",
          "group": "isarFlow@1"
        },
        {
          "command": "isarFlow.simulateWorkflow",
          "when": "resourceFilename =~ /\\.workflow\\.ya?ml$/",
          "group": "isarFlow@1"
        },
        {
          "command": "isarFlow.openYaml",
          "when": "resourceFilename =~ /\\.(workflow|agent)\\.ya?ml$/",
          "group": "isarFlow@2"
        }
      ],
      "editor/context": [
        {
          "command": "isarFlow.runFromHere",
          "when": "resourceFilename =~ /\\.workflow\\.ya?ml$/",
          "group": "isarFlow@1"
        },
        {
          "command": "isarFlow.runWorkflowOnSelection",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "isarFlow@2"
        }
      ],
      "commandPalette": [
        {
          "command": "isarFlow.openMemory",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "isarFlow.openYaml",
          "when": "activeCustomEditorId == isarFlow.workflowEditor || activeCustomEditorId == isarFlow.agentEditor"
        },
        {
          "command": "isarFlow.openInCanvas",
          "when": "resourceFilename =~ /\\.(workflow|agent)\\.ya?ml$/"
        }
      ]
    },
    "configuration": {
      "title": "Isar Flow",
      "properties": {
        "isarFlow.providers": {
          "type": "array",
          "default": [],
          "markdownDescription": "OpenAI-compatible model endpoints (LiteLLM, Ollama, vLLM, OpenRouter …). API keys are stored securely with **Isar Flow: Set provider API key**, never here.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "baseUrl"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$",
                "description": "Short id used in model references, e.g. litellm → litellm/gpt-4.1"
              },
              "label": {
                "type": "string",
                "description": "Display name"
              },
              "baseUrl": {
                "type": "string",
                "description": "Base URL, e.g. http://localhost:4000 or http://localhost:11434/v1"
              },
              "discoverModels": {
                "type": "boolean",
                "default": true,
                "description": "List models via GET /models"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Model ids offered in addition to (or instead of) discovered ones"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra HTTP headers"
              }
            }
          }
        },
        "isarFlow.vscodeModels": {
          "type": "boolean",
          "default": true,
          "description": "Offer the language models available in VS Code (for example GitHub Copilot)."
        },
        "isarFlow.defaultShell": {
          "type": "string",
          "enum": [
            "auto",
            "pwsh",
            "powershell",
            "cmd",
            "bash",
            "sh"
          ],
          "default": "auto",
          "enumDescriptions": [
            "PowerShell 7 or Windows PowerShell on Windows, your login shell elsewhere",
            "PowerShell 7",
            "Windows PowerShell",
            "Command Prompt",
            "Bash",
            "sh"
          ],
          "description": "Shell used by console blocks that do not choose one."
        },
        "isarFlow.maxTokensPerRun": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Stop a run when its agents used more tokens than this. 0 means no limit."
        },
        "isarFlow.confirmCommands": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Ask before running a workflow whose console commands, or agents that edit files or run commands without asking, you have not approved yet. Only your user settings can turn this off."
        },
        "isarFlow.historyLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Runs kept per workflow; simulated runs are counted separately. The snapshots and worktrees of older runs are removed too."
        },
        "isarFlow.agentContextTokens": {
          "type": "number",
          "default": 24000,
          "minimum": 2000,
          "description": "Context size in tokens for models that don't report one. Agent conversations are summarized at 70 % of it."
        },
        "isarFlow.modelPrices": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "object",
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0,
                "description": "Price per 1 million input tokens"
              },
              "output": {
                "type": "number",
                "minimum": 0,
                "description": "Price per 1 million output tokens"
              }
            }
          },
          "markdownDescription": "Prices per 1 million tokens by model reference, used to estimate the cost of runs. Costs are shown only for the models listed here. Example: `{ \"litellm/gpt-4.1\": { \"input\": 2, \"output\": 8 } }`"
        },
        "isarFlow.triggers.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Start workflows from their `on:` triggers (save, file change, schedule) while VS Code is open. Triggers only run in trusted workspaces and after you approved the workflow's commands once."
        }
      }
    },
    "languageModelTools": [
      {
        "name": "isarflow_listWorkflows",
        "displayName": "List Isar Flow workflows",
        "toolReferenceName": "isarflowWorkflows",
        "canBeReferencedInPrompt": true,
        "userDescription": "Lists the workflows Copilot may run.",
        "modelDescription": "Lists the Isar Flow workflows of this workspace that the user allows Copilot to run, with their names, paths, descriptions and inputs. Call it before isarflow_runWorkflow.",
        "tags": [
          "isarflow"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "isarflow_runWorkflow",
        "displayName": "Run an Isar Flow workflow",
        "toolReferenceName": "isarflowRun",
        "canBeReferencedInPrompt": true,
        "userDescription": "Runs a workflow and returns its summary.",
        "modelDescription": "Runs one Isar Flow workflow locally in VS Code and waits until it has finished. Returns the status, the outputs of its blocks and the files it changed. Only workflows listed by isarflow_listWorkflows can be run; the user confirms each run.",
        "tags": [
          "isarflow"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "string",
              "description": "Workflow name or workspace-relative path, as listed by isarflow_listWorkflows."
            },
            "inputs": {
              "type": "object",
              "description": "Input values by input name.",
              "additionalProperties": true
            }
          },
          "required": [
            "workflow"
          ]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "isarFlow.chat",
        "name": "isarflow",
        "fullName": "Isar Flow",
        "description": "Run your local workflows",
        "commands": [
          {
            "name": "list",
            "description": "List the workflows Copilot may run"
          },
          {
            "name": "run",
            "description": "Run a workflow: /run <workflow> [name=value …]"
          },
          {
            "name": "status",
            "description": "Show running and recent runs"
          }
        ]
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.workflow.yaml",
        "url": "./schemas/workflow.schema.json"
      },
      {
        "fileMatch": "*.workflow.yml",
        "url": "./schemas/workflow.schema.json"
      },
      {
        "fileMatch": "*.agent.yaml",
        "url": "./schemas/agent.schema.json"
      },
      {
        "fileMatch": "*.agent.yml",
        "url": "./schemas/agent.schema.json"
      },
      {
        "fileMatch": "**/.isarflow/simulations/*.sim.yaml",
        "url": "./schemas/simulation.schema.json"
      },
      {
        "fileMatch": "**/.isarflow/simulations/*.sim.yml",
        "url": "./schemas/simulation.schema.json"
      },
      {
        "fileMatch": ".isarflow/config.yaml",
        "url": "./schemas/config.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "npm run build && node ./test/integration/runTests.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@isar-flow/core": "*",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3"
  }
}
