            "files"
          ],
          "additionalProperties": false
        },
        "schedule": {
          "type": "object",
          "properties": {
            "every": {
              "type": "string",
              "pattern": "^(?:\\d+[smhd])+$",
              "description": "Interval while VS Code is open, e.g. \"15m\", \"1h\", \"1d\" (at least 1m)."
            }
          },
          "required": [
            "every"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Start the workflow automatically (trusted workspaces only, after its commands were approved once)."
    },
    "expose": {
      "description": "Let Copilot run this workflow (language model tools and @isarflow).",
      "type": "boolean"
    },
    "steps": {
