{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Isar Flow workflow format version."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "description": "Values asked for when the run starts; referenced as inputs.<name>.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": {
            "type": "string"
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "multiline": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "isolation": {
      "description": "Where the run changes files: workspace (default) or worktree (git only: a separate git worktree; you choose which changes to keep).",
      "type": "string",
      "enum": [
        "workspace",
        "worktree"
      ]
    },
    "setup": {
      "description": "Commands run in the worktree before the first block, e.g. \"npm ci\".",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "on": {
      "type": "object",
      "properties": {
        "save": {
          "description": "Run when a matching file is saved in VS Code.",
          "type": "object",
          "properties": {
            "files": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ],
              "description": "Workspace-relative glob or list of globs, e.g. \"src/**/*.ts\"; in a list, \"!pattern\" excludes files."
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "change": {
          "description": "Run when a matching file is created, changed or deleted on disk.",
          "type": "object",
          "properties": {
            "files": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
